<ScopestrengthWeb.Sidebar.app_shell
  id="mobile-sidebar"
  label=""
  home={~p"/trainer"}
  role="Trainer"
  user_name={@current_user.name}
  active_path={assigns[:active_path]}
  notifications_path={~p"/trainer/notifications"}
  unread_count={assigns[:unread_count] || 0}
  items={[
    %{label: "Dashboard", path: ~p"/trainer", icon: "hero-squares-2x2", exact: true},
    %{label: "Clients", path: ~p"/trainer/clients", icon: "hero-users"},
    %{label: "Programmes", path: ~p"/trainer/programmes", icon: "hero-clipboard-document-list"},
    %{label: "Volume", path: ~p"/trainer/exercises/contribution", icon: "hero-chart-bar"},
    %{label: "Exercises", path: ~p"/trainer/exercises", icon: "hero-bars-3-bottom-left", exact: true},
    %{label: "Invites", path: ~p"/trainer/invites", icon: "hero-envelope"},
    %{label: "Chat", path: ~p"/trainer/chat", icon: "hero-chat-bubble-left"}
  ]}
  footer_items={[
    %{label: "Settings", path: ~p"/trainer/settings", icon: "hero-cog-6-tooth"}
  ]}
>
  <div
    :if={@current_user.type == "demo"}
    class="flex items-center gap-3 border-b border-warning/30 bg-warning/10 px-4 py-3 text-warning md:px-6"
  >
    <.icon name="hero-information-circle" class="h-5 w-5 shrink-0" />
    <span class="text-sm font-medium">You're exploring a demo account with sample data</span>
  </div>

  <ScopestrengthWeb.SubscriptionBanner.subscription_banner
    subscription_status={assigns[:subscription_status] || :trial}
    trial_days_remaining={assigns[:trial_days_remaining] || 0}
    current_user={@current_user}
  />

  <div class="flex-1 p-4 md:p-6 lg:p-8">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</ScopestrengthWeb.Sidebar.app_shell>
