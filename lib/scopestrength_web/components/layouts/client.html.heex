<ScopestrengthWeb.Sidebar.app_shell
  id="client-mobile-sidebar"
  label=""
  home={~p"/client"}
  role="Client"
  user_name={@current_user.name}
  active_path={assigns[:active_path]}
  notifications_path={~p"/client/notifications"}
  unread_count={assigns[:unread_count] || 0}
  items={[
    %{label: "Dashboard", path: ~p"/client", icon: "hero-squares-2x2", exact: true},
    %{label: "Workouts", path: ~p"/client/workouts", icon: "hero-bolt"},
    %{label: "Programmes", path: ~p"/client/programmes", icon: "hero-clipboard-document-list"},
    %{label: "Volume", path: ~p"/client/volumeTracking", icon: "hero-chart-bar"},
    %{label: "Exercises", path: ~p"/client/exercises", icon: "hero-bars-3-bottom-left"},
    %{label: "Chat", path: ~p"/client/chat", icon: "hero-chat-bubble-left"},
    %{label: "Progress Photos", path: ~p"/client/progress-photos", icon: "hero-camera"}
  ]}
  footer_items={[
    %{label: "Settings", path: ~p"/client/settings", icon: "hero-cog-6-tooth"}
  ]}
>
  <div
    :if={@current_user.type == "demo"}
    class="flex items-center gap-3 border-b border-warning/30 bg-warning/10 px-4 py-3 text-warning md:px-6"
  >
    <.icon name="hero-information-circle" class="h-5 w-5 shrink-0" />
    <span class="text-sm font-medium">You're exploring a demo account with sample data</span>
  </div>

  <div class="flex-1 p-4 md:p-6 lg:p-8">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</ScopestrengthWeb.Sidebar.app_shell>
