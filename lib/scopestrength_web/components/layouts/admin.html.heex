<ScopestrengthWeb.Sidebar.app_shell
  id="admin-mobile-sidebar"
  label="Admin"
  short="A"
  home={~p"/admin"}
  role="Admin"
  user_name={@current_user.name}
  active_path={assigns[:active_path]}
  items={[
    %{label: "Dashboard", path: ~p"/admin", icon: "hero-squares-2x2", exact: true}
  ]}
>
  <div class="flex-1 p-4 md:p-6 lg:p-8">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</ScopestrengthWeb.Sidebar.app_shell>
