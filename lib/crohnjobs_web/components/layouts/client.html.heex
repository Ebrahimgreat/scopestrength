<div class="min-h-screen flex bg-gradient-to-br from-slate-100 via-white to-slate-50">
  <aside class="w-72 bg-slate-900 text-slate-100 flex flex-col border-r border-slate-800 sticky top-0 h-screen">
    <div class="px-6 py-6 border-b border-slate-800">
      <.link href={~p"/client"} class="inline-flex items-center gap-2 text-lg font-semibold tracking-tight text-white hover:text-emerald-200">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-300 text-sm font-bold">
          CP
        </span>
        Client Portal
      </.link>
      <div class="mt-4 flex items-center gap-3">
        <div class="h-9 w-9 rounded-full bg-gradient-to-br from-emerald-400/30 to-emerald-600/30 border border-emerald-400/30"></div>
        <div>
          <p class="text-sm font-medium text-slate-100">{@current_user.name}</p>
          <p class="text-xs text-slate-400">Client</p>
        </div>
      </div>
    </div>

    <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
      <.link
        href={~p"/client"}
        class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-200 hover:bg-slate-800 hover:text-white transition"
      >
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-slate-800 text-slate-300 group-hover:bg-emerald-500/20 group-hover:text-emerald-200">
          D
        </span>
        Dashboard
      </.link>
      <.link
        href={~p"/client/workouts"}
        class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-200 hover:bg-slate-800 hover:text-white transition"
      >
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-slate-800 text-slate-300 group-hover:bg-emerald-500/20 group-hover:text-emerald-200">
          W
        </span>
        Workouts
      </.link>
      <.link
        href={~p"/client/exercises"}
        class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-200 hover:bg-slate-800 hover:text-white transition"
      >
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-slate-800 text-slate-300 group-hover:bg-emerald-500/20 group-hover:text-emerald-200">
          E
        </span>
        Exercises
      </.link>
      <.link
        href={~p"/client/chat"}
        class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-200 hover:bg-slate-800 hover:text-white transition"
      >
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-slate-800 text-slate-300 group-hover:bg-emerald-500/20 group-hover:text-emerald-200">
          C
        </span>
        Chat
      </.link>
      
    </nav>

    <div class="mt-auto px-4 py-5 border-t border-slate-800 space-y-2">
      <.link
        href={~p"/client/settings"}
        class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-200 hover:bg-slate-800 hover:text-white transition"
      >
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-slate-800 text-slate-300 group-hover:bg-emerald-500/20 group-hover:text-emerald-200">
          S
        </span>
        Settings
      </.link>
      <.link
        href={~p"/users/log_out"}
        method="delete"
        class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-rose-200 hover:bg-rose-500/10 hover:text-rose-100 transition"
      >
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-rose-500/10 text-rose-200 group-hover:bg-rose-500/20">
          L
        </span>
        Log out
      </.link>
    </div>
  </aside>

  <main class="flex-1 p-6 lg:p-8">
   
   

    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>
